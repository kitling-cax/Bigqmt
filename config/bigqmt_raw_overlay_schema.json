    "trade_date": "DATE",
    "period": "VARCHAR",
    "adjustment_mode": "VARCHAR",
    "open": "DOUBLE",
    "high": "DOUBLE",
    "low": "DOUBLE",
    "close": "DOUBLE",
    "volume_lots": "DOUBLE",
    "amount_yuan": "DOUBLE",
    "source": "VARCHAR",
    "source_release": "VARCHAR",
    "available_at": "TIMESTAMP WITH TIME ZONE",
    "row_hash": "VARCHAR"
  },
  "raw_rules": {
    "adjustment_mode": "none only",
    "price_units": "CNY per share or unit",
    "volume_units": "hands/lots; use measured QMT evidence",
