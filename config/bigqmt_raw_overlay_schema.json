    "null_ohlcv": "reject from publishable candidate",
    "pre_listing_zero_rows": "quarantine and never manufacture prices",
    "legacy_bars_raw": "do not append without explicit schema migration"
  },
  "release_gates": [
    "candidate_import_readiness",
