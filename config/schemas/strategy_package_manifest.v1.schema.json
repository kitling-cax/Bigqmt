{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigqmt://schemas/strategy_package_manifest.v1",
  "title": "BigQMT immutable strategy package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_family_id",
    "strategy_id",
    "version",
    "build_id",
    "exclusive_group",
    "bridge_rpc_version",
    "runtime",
    "artifacts",
    "published_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "strategy_family_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "strategy_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._+-]+$"},
    "build_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "exclusive_group": {"type": "string", "minLength": 1, "maxLength": 128},
    "bridge_rpc_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platforms"],
      "properties": {
        "python": {"type": "string", "minLength": 1, "maxLength": 32},
        "platforms": {"type": "array", "minItems": 1, "items": {"enum": ["windows-x64"]}}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "backtest_report_path": {"type": "string", "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.).+$"},
    "published_at": {"type": "string", "format": "date-time"},
    "publisher_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "signature": {"type": "string", "minLength": 1}
  }
}
