{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigqmt://schemas/strategy_runtime.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "account_id", "strategy_id", "host_id", "state", "event_time", "received_time"],
  "properties": {
    "schema_version": {"const": 1}, "event_id": {"type": "string", "format": "uuid"},
    "account_id": {"type": "string"}, "strategy_id": {"type": "string"}, "host_id": {"type": "string"},
    "state": {"enum": ["STARTING", "RUNNING", "PAUSED", "DEGRADED", "STOPPED"]},
    "event_time": {"type": "string", "format": "date-time"}, "received_time": {"type": "string", "format": "date-time"}
  }
}
