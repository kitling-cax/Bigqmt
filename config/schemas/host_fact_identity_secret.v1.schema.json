{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigqmt://schemas/host_fact_identity_secret.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hosts"],
  "properties": {
    "schema_version": {"const": 1},
    "hosts": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["host_id", "key_id", "status", "secret_b64"],
        "properties": {
          "host_id": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 8},
          "status": {"enum": ["ACTIVE", "NEXT", "REVOKED"]},
          "secret_b64": {"type": "string", "minLength": 43}
        }
      }
    }
  },
  "description": "Secret-file contract only. Do not commit this file, place it on NAS, or include it in an image."
}
