{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigqmt://schemas/strategy_assignment.v1",
  "title": "BigQMT strategy execution assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "strategy_account_id",
    "strategy_id",
    "strategy_version",
    "exclusive_group",
    "target_host_id",
    "assignment_epoch",
    "desired_state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "assignment_id": {"type": "string", "format": "uuid"},
    "strategy_account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "strategy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "strategy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "build_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "exclusive_group": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_host_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "assignment_epoch": {"type": "integer", "minimum": 1},
    "desired_state": {"enum": ["DEPLOY", "RUN", "PAUSE", "STOP", "REMOVE"]},
    "execution_mode": {"enum": ["EXECUTE", "READ_ONLY", "SHADOW"]},
    "checkpoint_id": {"type": "string", "format": "uuid"},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
