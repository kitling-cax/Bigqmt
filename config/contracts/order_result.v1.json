{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigqmt://contracts/order_result.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "state", "reported_at"],
  "properties": {
    "schema_version": {"const": 1}, "request_id": {"type": "string", "format": "uuid"},
    "state": {"enum": ["ACCEPTED", "SUBMITTED", "PARTIAL", "FILLED", "CANCELLED", "REJECTED", "UNKNOWN"]},
    "reason": {"type": "string"}, "reported_at": {"type": "string", "format": "date-time"}
  }
}
