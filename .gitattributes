# Keep source reviews deterministic across Windows, WSL and Ubuntu containers.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# SHA-256 manifests must round-trip through sha256sum and git diff byte-for-byte.
*.sha256 text eol=lf
